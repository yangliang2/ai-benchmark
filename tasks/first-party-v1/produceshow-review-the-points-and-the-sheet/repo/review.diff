+
+
+def test_a_class_judged_a_second_time_is_judged_afresh():
+    book = Book()
+    entry = Entry("ada", "three onions", 1)
+    book.take(entry)
+
+    book.judged(entry, "second")
+    book.judged(entry, "first")
+
+    assert entry.place == "first"
+
+
+def test_an_entry_the_judge_did_not_reach_has_no_placing():
+    assert Entry("ada", "three onions", 1).place is None
diff --git a/test_points.py b/test_points.py
new file mode 100644
--- /dev/null
+++ b/test_points.py
@@ -0,0 +1,16 @@
+from points import PLACES, champion
+
+
+def test_a_first_is_worth_four_and_a_third_two():
+    assert PLACES["first"] == 4
+    assert PLACES["second"] == 3
+    assert PLACES["third"] == 2
+
+
+def test_the_cup_goes_to_the_exhibitor_with_the_most():
+    assert champion({"ada": 12, "bob": 15, "cid": 4}) == "bob"
+
+
+def test_the_cup_stays_on_the_shelf_where_nobody_has_a_point():
+    assert champion({}) is None
+    assert champion({"ada": 0}) is None
